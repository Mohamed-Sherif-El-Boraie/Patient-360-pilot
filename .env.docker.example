# Copy this file to ".env" in the project folder (the real .env is never committed), fill the empty values, then:
#   docker run --rm --env-file .env <image> ...
# Docker's --env-file rules: one KEY=value per line, no quotes (they would become part of the value), no spaces around
# the "=", and a comment only on a line of its own (a comment after a value would become part of the value).

# PostgreSQL: the server NAME, never its IP (the certificate is checked against the name)
PGHOST=p360-postgre-srv.postgres.database.azure.com
PGPORT=5432
PGDATABASE=postgres
PGUSER=p360dbadmin
PGPASSWORD=
PGSCHEMA=p360
PGSSLMODE=verify-full
PGSSLROOTCERT=/app/.venv/lib/python3.13/site-packages/certifi/cacert.pem

# Blob: the SAS URL of each container, https://p360stgaccallservices.blob.core.windows.net/<container>?<token>
# raw needs read + write + create; the four output containers need create + write
BLOB_OUTPUT_URL_RAW=
BLOB_OUTPUT_URL_URGENT=
BLOB_OUTPUT_URL_SYMPTOM_CHECKER=
BLOB_OUTPUT_URL_BATCH=
BLOB_OUTPUT_URL_ON_DEMAND=

# AWS S3 (Frankfurt, through the VPC endpoint: keep the word "bucket" in the address)
AWS_REGION=eu-central-1
AWS_ENDPOINT_URL_S3=https://bucket.vpce-0b99bbfef92f6b428-5urfgr0g.s3.eu-central-1.vpce.amazonaws.com
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET_URGENT=p360-urgent
S3_BUCKET_SYMPTOM_CHECKER=p360-symptom-checker
S3_BUCKET_BATCH=p360-batch
S3_BUCKET_ON_DEMAND=p360-on-demand

# The Backend wrapper: all six or none
BACKEND_BASE_URL=https://integrations.idhcorp.com
BACKEND_CALLER_SOURCE=Patient360
BACKEND_CALLER_SOURCE_KEY=
BACKEND_CALLER_USER_NAME=Patient360
BACKEND_USERNAME=
BACKEND_PASSWORD=

# Our own secrets. IDEMPOTENCY_KEY_SECRET: make one long random value, then never change it (the duplicate keys of
# every visit are made from it). INBOUND_API_KEY: only the Function app (ai-results) must send it in X-Api-Key; the Backend and the wrapper send none.
IDEMPOTENCY_KEY_SECRET=
INBOUND_API_KEY=

# Azure App Service only: the port the app listens on (App Service probes port 80 unless told otherwise)
WEBSITES_PORT=8000
