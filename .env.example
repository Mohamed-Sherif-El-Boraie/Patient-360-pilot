# Copy to .env for local work (the real .env is never committed), then:  uv run --env-file .env ...
# In Azure these are the App Service application settings; secrets are Key Vault references.

APP_ENV=development            # development | pilot | production (default production)
TELEMETRY_ENABLED=false        # true | false (default false): OpenTelemetry. Not built yet, the switch is ready
LOG_LEVEL=DEBUG                # DEBUG | INFO | WARNING | ERROR (default: DEBUG in development, INFO in production)
LOG_FORMAT=console             # console | json (default: console in development, json in production)

PGHOST=127.0.0.1               # use 127.0.0.1, not localhost, on Windows
PGPORT=5432                    # 6432 through the built-in PgBouncer on Azure
PGDATABASE=patient360
PGUSER=app
PGPASSWORD=change-me           # secret
PGSSLMODE=prefer               # verify-full in Azure (the default)

# Blob: in Azure give the account URL (the app signs in with its managed identity); locally give the Azurite
# connection string instead. One of the two is required.
AZURE_STORAGE_ACCOUNT_URL=https://youraccount.blob.core.windows.net
# AZURE_STORAGE_CONNECTION_STRING=   # secret; the Azurite emulator string for local work
BLOB_INPUT_CONTAINER=ai-input
BLOB_OUTPUT_CONTAINER=ai-output

IDEMPOTENCY_KEY_SECRET=change-me-to-a-long-random-value   # secret, at least 16 characters
# INBOUND_API_KEY=               # secret; callers must send it in the X-Api-Key header. Empty = not checked

# AWS S3 (one bucket per source); all four are needed to run the full flow.
# AWS_REGION=
# AWS_ENDPOINT_URL_S3=           # local work only: a MinIO server instead of AWS
# S3_BUCKET_ON_DEMAND=
# S3_BUCKET_URGENT=
# S3_BUCKET_SYMPTOM_CHECKER=
# S3_BUCKET_BATCH=

# The Backend wrapper: give all six or none (none = results are saved but not delivered).
# BACKEND_BASE_URL=https://integrations.idhcorp.com
# BACKEND_CALLER_SOURCE=Patient360
# BACKEND_CALLER_SOURCE_KEY=     # secret
# BACKEND_CALLER_USER_NAME=Patient360
# BACKEND_USERNAME=
# BACKEND_PASSWORD=              # secret
# BACKEND_CONNECT_TIMEOUT_S=5
# BACKEND_READ_TIMEOUT_S=30

# BATCH_SIZE=100                # visits per batch (per lane): 100 to 50000, default 100
# MAX_REQUEST_BYTES=             # biggest JSON body we accept; empty = no limit (set it once we know the real sizes)
# JOB_INTERVAL_S=300             # batch trigger and the sweeps, seconds (default 300 = 5 minutes)
# WORK_INTERVAL_S=5              # upload to S3 and deliver to the Backend, seconds (default 5)
